# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR FASTAPI
# ==============================================================================
PROJECT_NAME="Mio API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
VERSION="0.1.0"

# CORS Configuration (JSON Array formatted string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","http://127.0.0.1:8000","*"]

# ==============================================================================
# CONFIGURACIÓN DE SUPABASE (Auth, Database & Storage)
# ==============================================================================
# URL del proyecto Supabase (Dashboard -> Settings -> API -> Project URL)
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Llave anónima pública (Dashboard -> Settings -> API -> Project API keys -> anon/public)
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Llave de rol de servicio (Dashboard -> Settings -> API -> Project API keys -> service_role)
# PRECAUCIÓN: No exponer en frontend. Solo backend.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Secreto JWT para validar tokens (Dashboard -> Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# Nombre del bucket de Storage para avatares de perfil
SUPABASE_AVATARS_BUCKET="avatars"

# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR FASTAPI (solo local / referencia)
# En Render: cargar estas mismas keys en el dashboard (Environment Variables).
# No versionar el archivo .env con valores reales.
# ==============================================================================
PROJECT_NAME="Mio API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
VERSION="0.1.0"

# CORS: lista JSON o CSV. Nunca dejar la variable vacía en Render (usar [] si aún no hay FE).
# En producción: ["https://tu-app.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000"]

# Regex opcional para previews de Vercel / localhost dinámico
BACKEND_CORS_ORIGIN_REGEX="^https://.*\\.vercel\\.app$|^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$"

# Mock auth solo para desarrollo local sin Supabase
USE_MOCK_AUTH=false

# ==============================================================================
# SUPABASE (Auth, Database & Storage) — valores desde el dashboard de Supabase
# ==============================================================================
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# Debe coincidir con el bucket real en Supabase Storage
SUPABASE_AVATARS_BUCKET="profiles"
